{
  "name": "oca-tests",
  "version": "1.0.0",
  "description": "Data-driven Playwright framework for HPE OCA model configuration automation",
  "private": true,
  "scripts": {
    "oca": "tsx src/main.ts",
    "ui": "tsx src/app/ui-server.ts",
    "sample:excel": "tsx scripts/create-sample-workbook.ts",
    "template:excel": "tsx scripts/create-input-template.ts",
    "lint": "eslint src scripts tests/unit --ext .ts",
    "test": "playwright test",
    "test:unit": "playwright test tests/unit --workers=1",
    "typecheck": "tsc --noEmit",
    "build": "tsc -p tsconfig.build.json"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/multer": "^2.2.0",
    "@types/node": "^20.14.0",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "eslint": "^8.57.1",
    "tsx": "^4.19.0",
    "typescript": "^5.5.0"
  },
  "dependencies": {
    "@playwright/test": "^1.48.0",
    "express": "^5.2.1",
    "multer": "^2.3.0",
    "xlsx": "^0.18.5"
  }
}
